# Copy this file to .env.local (or .env) and adjust per environment.
# Vite only exposes variables prefixed with VITE_ to client code.

# Anomaly Detection backend (Java/Spring Boot)
VITE_ANOMALY_API_BASE_URL=http://localhost:8080/api/v1/dataset

# Forecasting backend (Python/FastAPI, Autoformer + BiHyPE)
VITE_FORECAST_API_BASE_URL=http://localhost:8000/api/v1

# Imputation backend (Python/FastAPI, CSDI/BiHyPE)
VITE_IMPUTATION_API_BASE_URL=http://127.0.0.1:8800/api
